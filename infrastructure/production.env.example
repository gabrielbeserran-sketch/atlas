ATLAS_ENV=production
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:CHANGE_ME@db:5432/atlas
ATLAS_JWT_SECRET=CHANGE_ME_MINIMUM_64_RANDOM_CHARACTERS
ATLAS_ACCESS_TOKEN_MINUTES=120
ATLAS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ATLAS_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
