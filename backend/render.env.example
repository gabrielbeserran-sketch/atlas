ATLAS_ENV=production

# RECOMENDADO PARA RENDER + SQLALCHEMY:
# Use o Supabase Session Pooler (DIRECT_URL na tela Connect), porta 5432.
# Substitua [YOUR-PASSWORD] pela senha REAL antes de salvar no Render.
ATLAS_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres

# No Render, RENDER_EXTERNAL_URL é detectado automaticamente pelo Atlas.
# Este valor pode permanecer como fallback HTTPS.
ATLAS_PUBLIC_BASE_URL=https://SEU-SERVICO.onrender.com
ATLAS_CORS_ORIGINS=https://SEU-SERVICO.onrender.com

ATLAS_ATTACHMENT_BACKEND=supabase
ATLAS_SUPABASE_URL=https://PROJECT_REF.supabase.co

# Aceita legacy service_role JWT ou nova sb_secret_* server-side.
ATLAS_SUPABASE_SERVICE_ROLE_KEY=COLE_SOMENTE_NO_RENDER
ATLAS_SUPABASE_STORAGE_BUCKET=atlas-animal-media


# ADMIN ONE-SHOT (staging/production)
# Use somente para criar/regularizar o primeiro administrador.
# Após o deploy mostrar "ATLAS ADMIN PROVISION: APROVADO":
# 1) volte ATLAS_PROVISION_ADMIN_ONCE para false;
# 2) remova ATLAS_PROVISION_ADMIN_PASSWORD do Render.
ATLAS_PROVISION_ADMIN_ONCE=false
ATLAS_PROVISION_ADMIN_EMAIL=
ATLAS_PROVISION_ADMIN_PASSWORD=
ATLAS_PROVISION_COMPANY_NAME=
