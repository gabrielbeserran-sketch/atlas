ATLAS_ENV=development
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:change-me@localhost:5432/atlas
ATLAS_JWT_SECRET=replace-with-at-least-32-random-characters
ATLAS_ACCESS_TOKEN_MINUTES=60
ATLAS_BOOTSTRAP_ENABLED=true
ATLAS_BOOTSTRAP_ADMIN_EMAIL=admin@atlas.local
ATLAS_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
ATLAS_BOOTSTRAP_COMPANY_NAME=Empresa Atlas
ATLAS_AUTO_CREATE_SCHEMA=false
ATLAS_DB_CONNECT_TIMEOUT_SECONDS=10
ATLAS_DB_POOL_SIZE=10
ATLAS_DB_MAX_OVERFLOW=20
ATLAS_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

ATLAS_REFRESH_TOKEN_DAYS=30
ATLAS_EMAIL_TOKEN_MINUTES=30
ATLAS_PASSWORD_RESET_MINUTES=20
ATLAS_MAX_FAILED_LOGINS=5
ATLAS_LOCKOUT_MINUTES=15
ATLAS_PUBLIC_BASE_URL=http://127.0.0.1:8000
ATLAS_EMAIL_SENDER=no-reply@atlas.local
ATLAS_IOT_INGEST_KEY=atlas-iot-development-key
