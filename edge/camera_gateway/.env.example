# Backend Atlas publicado.
ATLAS_CAMERA_GATEWAY_BASE_URL=https://atlas-api-29y2.onrender.com/api/v1

# Deve ser exatamente o external_id da câmera cadastrada no Precision Hub.
ATLAS_CAMERA_DEVICE_EXTERNAL_ID=porteira-principal

# Use a mesma chave segura configurada no backend Render.
# Não versionar o valor real.
ATLAS_IOT_INGEST_KEY=

# Fila local durável para operar mesmo quando a internet cair.
ATLAS_CAMERA_GATEWAY_SPOOL_DIR=./spool
